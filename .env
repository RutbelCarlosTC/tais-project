# Configuración de Proveedor de LLM (opcional: mock, openai, gemini, ollama)
# Por defecto se utiliza "mock" para pruebas 100% autónomas y reproducibles sin costo.
LLM_PROVIDER=mock

# Para usar OpenAI:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Para usar Google Gemini:
# LLM_PROVIDER=gemini
GEMINI_API_KEY=API-KEY-GENERADO
GEMINI_MODEL=gemini-3.8-flash

# Para usar Ollama:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3:8b

# Configuración del Vector Store y Embeddings
VECTOR_DB_DIR=./data/vector_store
EMBEDDING_PROVIDER=mock
TOP_K_RETRIEVAL=4
CHUNK_SIZE=600
CHUNK_OVERLAP=90
